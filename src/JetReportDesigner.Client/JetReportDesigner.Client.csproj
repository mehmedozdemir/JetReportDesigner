<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0 covers every .NET Framework / .NET app; the other two add the Windows printing helper. -->
    <TargetFrameworks>netstandard2.0;net48;net8.0-windows</TargetFrameworks>
    <!-- Written to be consumed by older C# / .NET Framework code, so the repo-wide strict style gates are off here. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <RootNamespace>JetReportDesigner.Client</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>

    <PackageId>JetReportDesigner.Client</PackageId>
    <Version>1.0.0</Version>
    <Description>Render JetReportDesigner reports from a desktop or server application: send your data as JSON, get back PDF / PNG / JPEG / HTML / XLSX, or print straight to a printer.</Description>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net8.0-windows'">
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JetReportDesigner.Client.Tests" />
  </ItemGroup>

</Project>
