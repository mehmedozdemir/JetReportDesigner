<?xml version="1.0" encoding="utf-8"?>
<!--
  Pin restore to the public feed. Central Package Management + TreatWarningsAsErrors
  turns "multiple package sources" (NU1507) into a build error, and this repo's
  packages are all on nuget.org. <clear/> drops any machine/user-level feeds for
  builds run inside this tree. Add <packageSourceMapping> here if a private feed
  is ever required.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
